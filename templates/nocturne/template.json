{
  "id": "nocturne",
  "name": "Nocturne",
  "version": 1,
  "description": "Sinematik gelap. Tiap bagian satu adegan setinggi layar yang mendarat lewat scroll-snap, tipografi besar di atas foto redup, aksen kuningan tipis.",
  "assets": {
    "fonts": [
      "https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500&display=swap"
    ],
    "css": [],
    "js": [
      "https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.js",
      "assets/js/rsvp.js",
      "assets/js/gift.js",
      "assets/js/qr-checkin.js",
      "assets/js/visual-editor/registry.js",
      "assets/js/visual-editor/guest-overrides.js"
    ]
  },
  "theme": {
    "--nc-bg": "#0c0c10",
    "--nc-bg-2": "#15151b",
    "--nc-ink": "#f1ece3",
    "--nc-ink-2": "#a5a09a",
    "--nc-ink-3": "#6f6b66",
    "--nc-brass": "#b3925f"
  },
  "editor": {
    "colors": [
      {
        "var": "--nc-bg",
        "label": "Latar utama"
      },
      {
        "var": "--nc-bg-2",
        "label": "Latar kartu"
      },
      {
        "var": "--nc-ink",
        "label": "Teks utama"
      },
      {
        "var": "--nc-ink-2",
        "label": "Teks sekunder"
      },
      {
        "var": "--nc-ink-3",
        "label": "Teks redup"
      },
      {
        "var": "--nc-brass",
        "label": "Aksen kuningan"
      }
    ],
    "sections": [
      {
        "key": "cover",
        "label": "Cover",
        "icon": "image",
        "fields": [],
        "photos": [
          {
            "slot": "cover",
            "label": "Foto cover",
            "ratio": "9/16",
            "min": 1,
            "max": 5
          }
        ]
      },
      {
        "key": "pembuka",
        "label": "Doa Pembuka",
        "icon": "book",
        "fields": [
          {
            "path": "opening.arabicQuote",
            "type": "textarea",
            "label": "Bismillah (arab)",
            "rows": 2
          },
          {
            "path": "opening.quote",
            "type": "textarea",
            "label": "Terjemahan",
            "rows": 4
          },
          {
            "path": "opening.source",
            "type": "text",
            "label": "Sumber (QS ...)"
          }
        ]
      },
      {
        "key": "mempelai",
        "label": "Mempelai",
        "icon": "heart",
        "fields": [
          {
            "path": "couple.bride.name",
            "type": "text",
            "label": "Nama pengantin wanita"
          },
          {
            "path": "couple.bride.nickname",
            "type": "text",
            "label": "Panggilan wanita"
          },
          {
            "path": "couple.bride.instagram",
            "type": "text",
            "label": "Instagram wanita (opsional)"
          },
          {
            "path": "couple.bride.father",
            "type": "text",
            "label": "Ayah wanita"
          },
          {
            "path": "couple.bride.mother",
            "type": "text",
            "label": "Ibu wanita"
          },
          {
            "path": "couple.groom.name",
            "type": "text",
            "label": "Nama pengantin pria"
          },
          {
            "path": "couple.groom.nickname",
            "type": "text",
            "label": "Panggilan pria"
          },
          {
            "path": "couple.groom.instagram",
            "type": "text",
            "label": "Instagram pria (opsional)"
          },
          {
            "path": "couple.groom.father",
            "type": "text",
            "label": "Ayah pria"
          },
          {
            "path": "couple.groom.mother",
            "type": "text",
            "label": "Ibu pria"
          }
        ],
        "photos": [
          {
            "slot": "bride",
            "label": "Foto mempelai wanita",
            "ratio": "3/4",
            "max": 1
          },
          {
            "slot": "groom",
            "label": "Foto mempelai pria",
            "ratio": "3/4",
            "max": 1
          }
        ]
      },
      {
        "key": "acara",
        "label": "Acara",
        "icon": "calendar",
        "fields": [
          {
            "path": "event.dateISO",
            "type": "date",
            "label": "Tanggal (ISO)"
          },
          {
            "path": "event.dateLabel",
            "type": "text",
            "label": "Tanggal tampil"
          },
          {
            "path": "event.dayLabel",
            "type": "text",
            "label": "Nama hari"
          },
          {
            "path": "event.countdownTarget",
            "type": "text",
            "label": "Target countdown (ISO + offset)"
          },
          {
            "path": "event.akad.label",
            "type": "text",
            "label": "Akad - label"
          },
          {
            "path": "event.akad.start",
            "type": "time",
            "label": "Akad - mulai"
          },
          {
            "path": "event.akad.end",
            "type": "time",
            "label": "Akad - selesai"
          },
          {
            "path": "event.akad.venue.name",
            "type": "text",
            "label": "Venue akad - nama"
          },
          {
            "path": "event.akad.venue.address",
            "type": "textarea",
            "label": "Venue akad - alamat"
          },
          {
            "path": "event.akad.venue.mapsUrl",
            "type": "url",
            "label": "Venue akad - URL Maps"
          },
          {
            "path": "event.resepsi.label",
            "type": "text",
            "label": "Resepsi - label"
          },
          {
            "path": "event.resepsi.start",
            "type": "time",
            "label": "Resepsi - mulai"
          },
          {
            "path": "event.resepsi.end",
            "type": "time",
            "label": "Resepsi - selesai"
          },
          {
            "path": "event.resepsi.venue.name",
            "type": "text",
            "label": "Venue resepsi - nama"
          },
          {
            "path": "event.resepsi.venue.address",
            "type": "textarea",
            "label": "Venue resepsi - alamat"
          },
          {
            "path": "event.resepsi.venue.mapsUrl",
            "type": "url",
            "label": "Venue resepsi - URL Maps"
          },
          {
            "path": "dresscode.text",
            "type": "textarea",
            "label": "Dresscode - teks"
          },
          {
            "path": "dresscode.colors",
            "type": "colorlist",
            "label": "Dresscode - warna"
          }
        ],
        "photos": [
          {
            "slot": "event",
            "label": "Foto latar acara",
            "ratio": "16/9",
            "max": 1
          }
        ]
      },
      {
        "key": "livestream",
        "label": "Live Streaming",
        "icon": "video",
        "fields": [
          {
            "path": "livestream.youtube",
            "type": "url",
            "label": "YouTube"
          },
          {
            "path": "livestream.instagram",
            "type": "url",
            "label": "Instagram"
          },
          {
            "path": "livestream.tiktok",
            "type": "url",
            "label": "TikTok"
          }
        ]
      },
      {
        "key": "cerita",
        "label": "Cerita Kami",
        "icon": "book",
        "fields": [
          {
            "path": "loveStory",
            "type": "list",
            "label": "Babak cerita"
          }
        ]
      },
      {
        "key": "galeri",
        "label": "Galeri",
        "icon": "image",
        "fields": [],
        "photos": [
          {
            "slot": "gallery",
            "label": "Foto galeri",
            "ratio": "1/1",
            "max": 24
          }
        ]
      },
      {
        "key": "hadiah",
        "label": "Hadiah & Ucapan",
        "icon": "gift",
        "fields": [
          {
            "path": "gift.accounts",
            "type": "list",
            "label": "Rekening"
          },
          {
            "path": "gift.contactCPW",
            "type": "text",
            "label": "CPW - nomor WA (62...)"
          },
          {
            "path": "gift.contactCPP",
            "type": "text",
            "label": "CPP - nomor WA (62...)"
          },
          {
            "path": "gift.address.recipient",
            "type": "text",
            "label": "Kado - penerima"
          },
          {
            "path": "gift.address.phone",
            "type": "text",
            "label": "Kado - telepon"
          },
          {
            "path": "gift.address.detail",
            "type": "textarea",
            "label": "Kado - alamat"
          },
          {
            "path": "gift.address.template",
            "type": "textarea",
            "label": "Template pesan kado"
          }
        ],
        "photos": [
          {
            "slot": "gift_item",
            "label": "Foto rekomendasi kado",
            "ratio": "1/1",
            "max": 12
          }
        ]
      },
      {
        "key": "penutup",
        "label": "Penutup",
        "icon": "sparkles",
        "fields": [
          {
            "path": "closing.text",
            "type": "textarea",
            "label": "Closing statement default"
          }
        ],
        "photos": [
          {
            "slot": "closing",
            "label": "Foto penutup",
            "ratio": "9/16",
            "max": 1
          }
        ]
      }
    ]
  }
}
