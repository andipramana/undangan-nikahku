{
  "id": "klasik",
  "name": "Classic Elegance",
  "version": 3,
  "description": "Hangat, emas, timeless. Cover layar penuh, kartu akad & resepsi, linimasa cerita, galeri bertumpuk.",
  "assets": {
    "fonts": [
      "assets/fonts/eb-garamond/eb-garamond-400.woff2",
      "assets/fonts/poppins/poppins-400.woff2"
    ],
    "css": [],
    "js": [
      "assets/js/hero-slideshow.js",
      "assets/js/reveal.js",
      "assets/js/countdown.js",
      "assets/js/gallery.js",
      "assets/js/couple-sliders.js",
      "assets/js/audio-player.js",
      "assets/js/gift.js",
      "assets/js/rsvp.js",
      "assets/js/livestream.js",
      "assets/js/nav-menu.js",
      "assets/js/qr-checkin.js",
      "assets/js/theme.js",
      "assets/js/visual-editor/registry.js",
      "assets/js/visual-editor/guest-overrides.js"
    ]
  },
  "theme": {
    "--color-bg": "#f7f3ea",
    "--color-dark": "#14120f",
    "--color-dark-2": "#1c1914",
    "--color-gold": "#c9a668",
    "--color-gold-soft": "#e6d7b3",
    "--color-text": "#2b2620",
    "--color-text-light": "#f7f3ea"
  },
  "editor": {
    "sections": [
      {
        "key": "cover",
        "label": "Cover & Sampul",
        "icon": "image",
        "cards": [
          {
            "name": "Cover",
            "desc": "Foto layar penuh pertama yang dilihat tamu."
          },
          {
            "name": "Subcover",
            "desc": "Quotes layar penuh antara Cover dan Save The Date. Kosongkan baris mana pun untuk menyembunyikannya."
          }
        ],
        "fields": [
          {
            "path": "subcover.enabled",
            "type": "switch",
            "label": "Tampilkan section Subcover",
            "card": "Subcover"
          },
          {
            "path": "subcover.quoteLine1",
            "type": "text",
            "label": "Quote baris 1",
            "card": "Subcover"
          },
          {
            "path": "subcover.quoteLine2",
            "type": "text",
            "label": "Quote baris 2",
            "card": "Subcover"
          }
        ],
        "photos": [
          {
            "slot": "cover",
            "label": "Foto cover",
            "card": "Cover",
            "ratio": "9/16",
            "min": 1,
            "max": 8
          },
          {
            "slot": "subcover",
            "label": "Foto subcover",
            "card": "Subcover",
            "ratio": "9/16",
            "max": 5
          }
        ]
      },
      {
        "key": "pembuka",
        "label": "Pembuka & Ayat",
        "icon": "quote",
        "fields": [
          {
            "path": "opening.arabicQuote",
            "type": "textarea",
            "label": "Bismillah (arab)",
            "card": "Ayat pembuka",
            "rows": 2
          },
          {
            "path": "opening.quote",
            "type": "textarea",
            "label": "Terjemahan",
            "card": "Ayat pembuka",
            "rows": 4
          },
          {
            "path": "opening.source",
            "type": "text",
            "label": "Sumber (QS ...)",
            "card": "Ayat pembuka"
          }
        ],
        "photos": [
          {
            "slot": "opening",
            "label": "Foto opening",
            "card": "Foto Save the Date",
            "cardDesc": "Folder opening (hero) dan std2 (foto statis Save the Date 2).",
            "ratio": "9/16",
            "max": 8
          },
          {
            "slot": "std2",
            "label": "Foto Save the Date 2",
            "card": "Foto Save the Date",
            "ratio": "9/16",
            "max": 5
          }
        ]
      },
      {
        "key": "mempelai",
        "label": "Mempelai",
        "icon": "heart",
        "fields": [
          {
            "path": "couple.bride.name",
            "type": "text",
            "label": "Nama lengkap",
            "card": "Mempelai wanita",
            "required": true
          },
          {
            "path": "couple.bride.nickname",
            "type": "text",
            "label": "Panggilan",
            "card": "Mempelai wanita"
          },
          {
            "path": "couple.bride.instagram",
            "type": "text",
            "label": "Instagram (opsional)",
            "card": "Mempelai wanita"
          },
          {
            "path": "couple.bride.father",
            "type": "text",
            "label": "Nama ayah",
            "card": "Mempelai wanita"
          },
          {
            "path": "couple.bride.mother",
            "type": "text",
            "label": "Nama ibu",
            "card": "Mempelai wanita"
          },
          {
            "path": "couple.bride.childOrder",
            "type": "text",
            "label": "Anak ke- (mis. pertama, kedua, bungsu)",
            "card": "Mempelai wanita",
            "placeholder": "pertama"
          },
          {
            "path": "couple.groom.name",
            "type": "text",
            "label": "Nama lengkap",
            "card": "Mempelai pria",
            "required": true
          },
          {
            "path": "couple.groom.nickname",
            "type": "text",
            "label": "Panggilan",
            "card": "Mempelai pria"
          },
          {
            "path": "couple.groom.instagram",
            "type": "text",
            "label": "Instagram (opsional)",
            "card": "Mempelai pria"
          },
          {
            "path": "couple.groom.father",
            "type": "text",
            "label": "Nama ayah",
            "card": "Mempelai pria"
          },
          {
            "path": "couple.groom.mother",
            "type": "text",
            "label": "Nama ibu",
            "card": "Mempelai pria"
          },
          {
            "path": "couple.groom.childOrder",
            "type": "text",
            "label": "Anak ke- (mis. pertama, kedua, bungsu)",
            "card": "Mempelai pria",
            "placeholder": "pertama"
          }
        ],
        "photos": [
          {
            "slot": "bride",
            "label": "Foto mempelai wanita",
            "card": "Mempelai wanita",
            "ratio": "3/4",
            "max": 8
          },
          {
            "slot": "groom",
            "label": "Foto mempelai pria",
            "card": "Mempelai pria",
            "ratio": "3/4",
            "max": 8
          }
        ]
      },
      {
        "key": "acara",
        "label": "Acara",
        "icon": "calendar",
        "fields": [
          {
            "path": "event.dateISO",
            "type": "text",
            "label": "Tanggal (ISO, yyyy-mm-dd)",
            "card": "Tanggal & countdown"
          },
          {
            "path": "event.dateLabel",
            "type": "text",
            "label": "Tanggal tampil",
            "card": "Tanggal & countdown",
            "required": true
          },
          {
            "path": "event.dayLabel",
            "type": "text",
            "label": "Nama hari",
            "card": "Tanggal & countdown"
          },
          {
            "path": "event.countdownTarget",
            "type": "text",
            "label": "Target countdown (ISO + offset)",
            "card": "Tanggal & countdown",
            "required": true
          },
          {
            "path": "event.akad.label",
            "type": "text",
            "label": "Label",
            "card": "Akad"
          },
          {
            "path": "event.akad.start",
            "type": "text",
            "label": "Mulai",
            "card": "Akad"
          },
          {
            "path": "event.akad.end",
            "type": "text",
            "label": "Selesai",
            "card": "Akad"
          },
          {
            "path": "event.akad.venue.name",
            "type": "text",
            "label": "Venue - nama",
            "card": "Akad"
          },
          {
            "path": "event.akad.venue.address",
            "type": "textarea",
            "label": "Venue - alamat",
            "card": "Akad",
            "rows": 2
          },
          {
            "path": "event.akad.venue.mapsUrl",
            "type": "text",
            "label": "Venue - URL Maps",
            "card": "Akad"
          },
          {
            "path": "event.resepsi.label",
            "type": "text",
            "label": "Label",
            "card": "Resepsi"
          },
          {
            "path": "event.resepsi.start",
            "type": "text",
            "label": "Mulai",
            "card": "Resepsi"
          },
          {
            "path": "event.resepsi.end",
            "type": "text",
            "label": "Selesai",
            "card": "Resepsi"
          },
          {
            "path": "event.resepsi.venue.name",
            "type": "text",
            "label": "Venue - nama",
            "card": "Resepsi"
          },
          {
            "path": "event.resepsi.venue.address",
            "type": "textarea",
            "label": "Venue - alamat",
            "card": "Resepsi",
            "rows": 2
          },
          {
            "path": "event.resepsi.venue.mapsUrl",
            "type": "text",
            "label": "Venue - URL Maps",
            "card": "Resepsi"
          },
          {
            "path": "dresscode.text",
            "type": "textarea",
            "label": "Teks",
            "card": "Dresscode",
            "rows": 3
          },
          {
            "path": "dresscode.colors",
            "type": "colorlist",
            "label": "Warna pilihan",
            "card": "Dresscode",
            "newItem": "#c9a668"
          }
        ],
        "photos": [
          {
            "slot": "event",
            "label": "Foto slider event",
            "ratio": "16/9",
            "max": 8
          },
          {
            "slot": "event_bg",
            "label": "Latar section Acara",
            "cardDesc": "Foto latar di belakang kartu Acara. Kosongkan = latar bawaan.",
            "ratio": "9/16",
            "max": 1
          }
        ]
      },
      {
        "key": "livestream",
        "label": "Live Streaming",
        "icon": "video",
        "fields": [
          {
            "path": "livestream.youtube",
            "type": "text",
            "label": "YouTube",
            "card": "Link siaran langsung",
            "cardDesc": "URL kosong = platform itu tidak ditampilkan; kosongkan semuanya untuk menyembunyikan section Live Streaming di undangan."
          },
          {
            "path": "livestream.instagram",
            "type": "text",
            "label": "Instagram",
            "card": "Link siaran langsung"
          },
          {
            "path": "livestream.tiktok",
            "type": "text",
            "label": "TikTok",
            "card": "Link siaran langsung"
          }
        ]
      },
      {
        "key": "cerita",
        "label": "Cerita Kami",
        "icon": "story",
        "fields": [
          {
            "path": "loveStory",
            "type": "list",
            "label": "Love Story",
            "card": "Love Story",
            "cardDesc": "Tiap babak tampil berurutan sebagai garis waktu.",
            "item": [
              {
                "key": "date",
                "label": "Tahun",
                "type": "text"
              },
              {
                "key": "title",
                "label": "Judul babak",
                "type": "text"
              },
              {
                "key": "text",
                "label": "Cerita",
                "type": "textarea",
                "rows": 4
              }
            ],
            "addLabel": "+ tambah babak"
          }
        ],
        "photos": [
          {
            "slot": "story",
            "label": "Foto Our Story",
            "ratio": "4/5",
            "max": 12
          }
        ]
      },
      {
        "key": "galeri",
        "label": "Galeri",
        "icon": "image",
        "cards": [
          {
            "name": "Video galeri",
            "desc": "Kosongkan untuk menyembunyikan thumbnail video di atas foto galeri."
          },
          {
            "name": "Foto galeri",
            "desc": ""
          },
          {
            "name": "Quote foto",
            "desc": "Foto 1:1 dengan kutipan di atasnya."
          }
        ],
        "fields": [
          {
            "path": "galleryVideo.youtube",
            "type": "text",
            "label": "Video galeri (YouTube URL)",
            "card": "Video galeri"
          },
          {
            "path": "quotePhoto.quote",
            "type": "textarea",
            "label": "Teks quote",
            "card": "Quote foto",
            "rows": 3
          }
        ],
        "photos": [
          {
            "slot": "gallery",
            "label": "Foto galeri",
            "card": "Foto galeri",
            "ratio": "1/1",
            "max": 40
          },
          {
            "slot": "quote",
            "label": "Foto quote",
            "card": "Quote foto",
            "ratio": "1/1",
            "max": 3
          }
        ]
      },
      {
        "key": "hadiah",
        "label": "Hadiah",
        "icon": "gift",
        "fields": [
          {
            "path": "gift.accounts",
            "type": "list",
            "label": "Rekening",
            "card": "Rekening",
            "item": [
              {
                "key": "bank",
                "label": "Bank",
                "type": "text"
              },
              {
                "key": "number",
                "label": "Nomor rekening",
                "type": "text"
              },
              {
                "key": "holder",
                "label": "Atas nama",
                "type": "text"
              },
              {
                "key": "owner",
                "label": "Pemilik rekening",
                "type": "select",
                "options": [
                  {
                    "value": "",
                    "label": "Tidak ikut"
                  },
                  {
                    "value": "cpw",
                    "label": "CPW (wanita)"
                  },
                  {
                    "value": "cpp",
                    "label": "CPP (pria)"
                  }
                ]
              },
              {
                "key": "placeholder",
                "label": "Sembunyikan nomor (placeholder)",
                "type": "switch"
              },
              {
                "key": "template",
                "label": "Pesan WA kustom",
                "type": "textarea",
                "rows": 3,
                "placeholder": "Pesan WA kustom (kosongkan = default). Token: ${tamu} ${CPP} ${CPW} ${LABEL}"
              }
            ],
            "addLabel": "+ tambah rekening"
          },
          {
            "path": "gift.contactCPW",
            "type": "text",
            "label": "CPW - nomor WA (62...)",
            "card": "Kontak WhatsApp konfirmasi",
            "cardDesc": "Dituju tombol Konfirmasi Pengiriman, dipilih otomatis dari field pemilik tiap rekening."
          },
          {
            "path": "gift.contactCPP",
            "type": "text",
            "label": "CPP - nomor WA (62...)",
            "card": "Kontak WhatsApp konfirmasi"
          },
          {
            "path": "gift.address.recipient",
            "type": "text",
            "label": "Penerima",
            "card": "Alamat kado"
          },
          {
            "path": "gift.address.phone",
            "type": "text",
            "label": "Telepon",
            "card": "Alamat kado"
          },
          {
            "path": "gift.address.detail",
            "type": "text",
            "label": "Detail alamat",
            "card": "Alamat kado"
          },
          {
            "path": "gift.address.template",
            "type": "textarea",
            "label": "Template pesan konfirmasi kado",
            "card": "Alamat kado",
            "rows": 3,
            "placeholder": "Token: ${tamu} ${CPP} ${CPW} ${LABEL}. Kosongkan = pesan default."
          }
        ],
        "photos": [
          {
            "slot": "gift_item",
            "label": "Rekomendasi kado",
            "cardDesc": "Nama, harga, dan link tiap rekomendasi diedit langsung pada kartu fotonya di bawah - foto ke-1 berpasangan dengan rekomendasi ke-1, dst.",
            "ratio": "1/1",
            "max": 12
          },
          {
            "slot": "gift_bg",
            "label": "Latar section Tanda Kasih",
            "cardDesc": "Foto latar di belakang kartu Tanda Kasih. Kosongkan = latar bawaan.",
            "ratio": "9/16",
            "max": 1
          }
        ]
      },
      {
        "key": "penutup",
        "label": "Penutup",
        "icon": "flag",
        "fields": [
          {
            "path": "closing.text",
            "type": "textarea",
            "label": "Teks penutup",
            "card": "Closing statement default",
            "cardDesc": "Dipakai untuk tamu yang tidak cocok dengan kelompok sapaan mana pun. Token: ${tamu} ${CPP} ${CPW}.",
