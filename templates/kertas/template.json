                "type": "switch"
              },
              {
                "key": "template",
                "label": "Pesan WA kustom",
                "type": "textarea",
                "rows": 3,
                "placeholder": "Pesan WA kustom (kosongkan = default). Token: ${tamu} ${CPP} ${CPW} ${LABEL}"
              }
            ],
            "addLabel": "+ tambah rekening"
          },
          {
            "path": "gift.contactCPW",
            "type": "text",
            "label": "CPW - nomor WA (62...)",
            "card": "Kontak WhatsApp konfirmasi",
            "cardDesc": "Dituju tombol Konfirmasi Pengiriman, dipilih otomatis dari field pemilik tiap rekening."
