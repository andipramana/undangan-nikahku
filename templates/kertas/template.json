{
  "id": "kertas",
  "name": "Kertas",
  "version": 1,
  "description": "Cetak risograph dua warna. Kertas daur ulang abu-netral, tinta hijau tua, dan satu warna kedua ultramarine. Nama mempelai dicetak besar dengan grotesk, halaman mengalir seperti majalah dengan daftar isi di tepi.",
  "assets": {
    "fonts": [
      "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..700&family=Newsreader:ital,opsz,wght@0,6..72,300..500;1,6..72,300..400&display=swap"
    ],
    "css": [],
    "js": [
      "https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.js",
      "assets/js/rsvp.js",
      "assets/js/gift.js",
      "assets/js/qr-checkin.js",
      "assets/js/visual-editor/registry.js",
      "assets/js/visual-editor/guest-overrides.js"
    ]
  },
  "theme": {
    "--kt-paper": "#f0efe9",
    "--kt-paper-2": "#e4e3db",
    "--kt-ink": "#17231f",
    "--kt-ink-2": "#4d5a55",
    "--kt-ink-3": "#8a938e",
    "--kt-accent": "#2f46c8"
  },
  "editor": {
    "colors": [
      {
        "key": "paper",
        "var": "--kt-paper",
        "label": "Kertas",
        "default": "#f0efe9"
      },
      {
        "key": "paper2",
        "var": "--kt-paper-2",
        "label": "Kertas (tua)",
        "default": "#e4e3db"
      },
      {
        "key": "ink",
        "var": "--kt-ink",
        "label": "Tinta utama",
        "default": "#17231f"
      },
      {
        "key": "ink2",
        "var": "--kt-ink-2",
        "label": "Tinta sekunder",
        "default": "#4d5a55"
      },
      {
        "key": "ink3",
        "var": "--kt-ink-3",
        "label": "Tinta redup",
        "default": "#8a938e"
      },
      {
        "key": "accent",
        "var": "--kt-accent",
        "label": "Tinta kedua",
        "default": "#2f46c8"
      }
    ],
    "sections": [
      {
        "key": "cover",
        "label": "Sampul",
        "icon": "image",
        "photos": [
          {
            "slot": "cover",
            "label": "Foto cover",
            "cardDesc": "Satu foto potret 4:5, dicetak di bawah nama.",
            "ratio": "9/16",
            "min": 1,
            "max": 3
          }
        ]
      },
      {
        "key": "pembuka",
        "label": "Doa Pembuka",
        "icon": "quote",
        "fields": [
          {
            "path": "opening.arabicQuote",
            "type": "textarea",
            "label": "Bismillah (arab)",
            "card": "Ayat pembuka",
            "rows": 2
          },
          {
            "path": "opening.quote",
            "type": "textarea",
            "label": "Terjemahan",
            "card": "Ayat pembuka",
            "rows": 4
          },
          {
            "path": "opening.source",
            "type": "text",
            "label": "Sumber (QS ...)",
            "card": "Ayat pembuka"
          }
        ]
      },
      {
        "key": "mempelai",
        "label": "Mempelai",
        "icon": "heart",
        "fields": [
