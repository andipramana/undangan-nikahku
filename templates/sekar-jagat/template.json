{
  "id": "sekar-jagat",
  "name": "Sekar Jagat",
  "version": 1,
  "description": "Nuansa keraton Jawa. Indigo wedelan dan emas tua, ornamen digambar SVG, potret mempelai berbingkai lengkung gebyok, motif kawung halus, dan latar yang bergerak lebih lambat dari isinya.",
  "assets": {
    "fonts": [
      "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,400&family=Mulish:wght@300;400;500;600&display=swap"
    ],
    "css": [],
    "js": [
      "https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.js",
      "assets/js/reveal.js",
      "assets/js/rsvp.js",
      "assets/js/gift.js",
      "assets/js/qr-checkin.js",
      "assets/js/visual-editor/registry.js",
      "assets/js/visual-editor/guest-overrides.js"
    ]
  },
  "theme": {
    "--sj-indigo": "#16233f",
    "--sj-indigo-2": "#1f3054",
    "--sj-cream": "#f2ebdd",
    "--sj-cream-2": "#e6dcc7",
    "--sj-gold": "#b08d3f",
    "--sj-ink": "#2a2418",
    "--sj-ink-2": "#6b6151"
  },
  "editor": {
    "colors": [
      {
        "key": "indigo",
        "var": "--sj-indigo",
        "label": "Indigo utama",
        "default": "#16233f"
      },
      {
        "key": "indigo2",
        "var": "--sj-indigo-2",
        "label": "Indigo terang",
        "default": "#1f3054"
      },
      {
        "key": "cream",
        "var": "--sj-cream",
        "label": "Krem gading",
        "default": "#f2ebdd"
      },
      {
        "key": "cream2",
        "var": "--sj-cream-2",
        "label": "Krem tua",
        "default": "#e6dcc7"
      },
      {
        "key": "gold",
        "var": "--sj-gold",
        "label": "Emas ornamen",
        "default": "#b08d3f"
      },
      {
        "key": "ink",
        "var": "--sj-ink",
        "label": "Teks utama",
        "default": "#2a2418"
      },
      {
        "key": "ink2",
        "var": "--sj-ink-2",
        "label": "Teks sekunder",
        "default": "#6b6151"
      }
