{
  "id": "sekar-jagat",
  "name": "Sekar Jagat",
  "version": 1,
  "description": "Nuansa keraton Jawa. Indigo wedelan dan emas tua, ornamen digambar SVG, potret mempelai berbingkai lengkung gebyok, motif kawung halus, dan latar yang bergerak lebih lambat dari isinya.",
  "assets": {
    "fonts": [
      "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,400&family=Mulish:wght@300;400;500;600&display=swap"
    ],
    "css": [],
    "js": [
      "https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.js",
      "assets/js/rsvp.js",
      "assets/js/gift.js",
      "assets/js/qr-checkin.js",
      "assets/js/visual-editor/registry.js",
      "assets/js/visual-editor/guest-overrides.js"
    ]
  },
  "theme": {
    "--sj-indigo": "#16233f",
    "--sj-indigo-2": "#1f3054",
    "--sj-cream": "#f2ebdd",
    "--sj-cream-2": "#e6dcc7",
    "--sj-gold": "#b08d3f",
    "--sj-ink": "#2a2418",
    "--sj-ink-2": "#6b6151"
  },
  "editor": {
    "colors": [
      {
        "key": "indigo",
        "var": "--sj-indigo",
        "label": "Indigo utama",
        "default": "#16233f"
      },
      {
        "key": "indigo2",
        "var": "--sj-indigo-2",
        "label": "Indigo terang",
        "default": "#1f3054"
      },
      {
        "key": "cream",
        "var": "--sj-cream",
        "label": "Krem gading",
        "default": "#f2ebdd"
      },
      {
        "key": "cream2",
        "var": "--sj-cream-2",
        "label": "Krem tua",
        "default": "#e6dcc7"
      },
      {
        "key": "gold",
        "var": "--sj-gold",
        "label": "Emas ornamen",
        "default": "#b08d3f"
      },
      {
        "key": "ink",
        "var": "--sj-ink",
        "label": "Teks utama",
        "default": "#2a2418"
      },
      {
        "key": "ink2",
        "var": "--sj-ink-2",
        "label": "Teks sekunder",
        "default": "#6b6151"
      }
    ],
    "sections": [
      {
        "key": "cover",
        "label": "Cover",
        "icon": "image",
        "photos": [
          {
            "slot": "cover",
            "label": "Foto cover",
            "cardDesc": "Satu foto layar penuh di balik nama, bergerak lambat mengikuti gulir (parallax).",
            "ratio": "9/16",
            "min": 1,
            "max": 5
          }
        ]
      },
      {
        "key": "pembuka",
        "label": "Doa Pembuka",
        "icon": "quote",
        "fields": [
          {
            "path": "opening.arabicQuote",
            "type": "textarea",
            "label": "Bismillah (arab)",
            "card": "Ayat pembuka",
            "rows": 2
          },
          {
            "path": "opening.quote",
            "type": "textarea",
            "label": "Terjemahan",
            "card": "Ayat pembuka",
            "rows": 4
          },
          {
            "path": "opening.source",
            "type": "text",
            "label": "Sumber (QS ...)",
            "card": "Ayat pembuka"
          }
        ]
      },
      {
        "key": "mempelai",
        "label": "Mempelai",
        "icon": "heart",
        "fields": [
          {
            "path": "couple.bride.name",
            "type": "text",
            "label": "Nama lengkap",
            "card": "Mempelai wanita",
            "required": true
          },
          {
            "path": "couple.bride.nickname",
            "type": "text",
            "label": "Panggilan",
            "card": "Mempelai wanita"
          },
          {
            "path": "couple.bride.instagram",
            "type": "text",
            "label": "Instagram (opsional)",
            "card": "Mempelai wanita"
          },
          {
            "path": "couple.bride.father",
            "type": "text",
            "label": "Nama ayah",
            "card": "Mempelai wanita"
          },
          {
            "path": "couple.bride.mother",
            "type": "text",
            "label": "Nama ibu",
            "card": "Mempelai wanita"
          },
          {
            "path": "couple.groom.name",
            "type": "text",
            "label": "Nama lengkap",
            "card": "Mempelai pria",
            "required": true
          },
          {
            "path": "couple.groom.nickname",
            "type": "text",
            "label": "Panggilan",
            "card": "Mempelai pria"
          },
          {
            "path": "couple.groom.instagram",
            "type": "text",
            "label": "Instagram (opsional)",
            "card": "Mempelai pria"
          },
          {
            "path": "couple.groom.father",
            "type": "text",
            "label": "Nama ayah",
            "card": "Mempelai pria"
          },
          {
            "path": "couple.groom.mother",
            "type": "text",
            "label": "Nama ibu",
            "card": "Mempelai pria"
          }
        ],
        "photos": [
          {
            "slot": "bride",
            "label": "Foto mempelai wanita",
            "card": "Mempelai wanita",
            "cardDesc": "Satu foto potret; dipasang dalam bingkai lengkung, jadi bagian atas foto ikut terpotong melengkung.",
            "ratio": "3/4",
            "max": 1
          },
          {
            "slot": "groom",
            "label": "Foto mempelai pria",
            "card": "Mempelai pria",
            "ratio": "3/4",
            "max": 1
          }
        ]
      },
      {
        "key": "acara",
        "label": "Acara",
        "icon": "calendar",
        "fields": [
          {
            "path": "event.dateISO",
            "type": "text",
            "label": "Tanggal (ISO, yyyy-mm-dd)",
            "card": "Tanggal & countdown"
          },
          {
            "path": "event.dateLabel",
            "type": "text",
            "label": "Tanggal tampil",
            "card": "Tanggal & countdown",
            "required": true
          },
          {
            "path": "event.dayLabel",
            "type": "text",
            "label": "Nama hari",
            "card": "Tanggal & countdown"
          },
          {
            "path": "event.countdownTarget",
            "type": "text",
            "label": "Target countdown (ISO + offset)",
            "card": "Tanggal & countdown",
            "required": true
          },
          {
            "path": "event.akad.label",
            "type": "text",
            "label": "Label",
            "card": "Akad"
          },
          {
            "path": "event.akad.start",
            "type": "text",
            "label": "Mulai",
            "card": "Akad"
          },
          {
            "path": "event.akad.end",
            "type": "text",
            "label": "Selesai",
            "card": "Akad"
          },
          {
            "path": "event.akad.venue.name",
            "type": "text",
            "label": "Venue - nama",
            "card": "Akad"
          },
          {
            "path": "event.akad.venue.address",
            "type": "textarea",
            "label": "Venue - alamat",
            "card": "Akad",
            "rows": 2
          },
          {
            "path": "event.akad.venue.mapsUrl",
            "type": "text",
            "label": "Venue - URL Maps",
            "card": "Akad"
          },
          {
            "path": "event.resepsi.label",
            "type": "text",
            "label": "Label",
            "card": "Resepsi"
          },
          {
            "path": "event.resepsi.start",
            "type": "text",
            "label": "Mulai",
            "card": "Resepsi"
          },
          {
            "path": "event.resepsi.end",
            "type": "text",
            "label": "Selesai",
            "card": "Resepsi"
          },
          {
            "path": "event.resepsi.venue.name",
            "type": "text",
            "label": "Venue - nama",
            "card": "Resepsi"
          },
          {
            "path": "event.resepsi.venue.address",
            "type": "textarea",
            "label": "Venue - alamat",
            "card": "Resepsi",
            "rows": 2
          },
          {
            "path": "event.resepsi.venue.mapsUrl",
            "type": "text",
            "label": "Venue - URL Maps",
            "card": "Resepsi"
          },
          {
            "path": "dresscode.text",
            "type": "textarea",
            "label": "Teks",
            "card": "Dresscode",
            "rows": 3
          },
          {
            "path": "dresscode.colors",
            "type": "colorlist",
            "label": "Warna pilihan",
            "card": "Dresscode",
            "newItem": "#c9a668"
          }
        ],
        "photos": [
          {
            "slot": "event",
            "label": "Foto latar acara",
            "cardDesc": "Satu foto latar di belakang kartu akad & resepsi, ditampilkan redup.",
            "ratio": "16/9",
            "max": 1
          }
        ]
      },
      {
        "key": "livestream",
        "label": "Live Streaming",
        "icon": "video",
        "fields": [
          {
            "path": "livestream.youtube",
            "type": "text",
            "label": "YouTube",
            "card": "Link siaran langsung",
            "cardDesc": "Kosongkan semuanya untuk menghapus adegan Live Streaming dari undangan."
          },
          {
            "path": "livestream.instagram",
            "type": "text",
            "label": "Instagram",
            "card": "Link siaran langsung"
          },
          {
            "path": "livestream.tiktok",
            "type": "text",
            "label": "TikTok",
            "card": "Link siaran langsung"
          }
        ]
      },
      {
        "key": "cerita",
        "label": "Cerita Kami",
        "icon": "story",
        "fields": [
          {
            "path": "loveStory",
            "type": "list",
            "label": "Love Story",
            "card": "Love Story",
            "cardDesc": "Tampil sebagai daftar babak dalam satu adegan.",
            "item": [
              {
                "key": "date",
                "label": "Tahun",
                "type": "text"
              },
              {
                "key": "title",
                "label": "Judul babak",
                "type": "text"
              },
              {
                "key": "text",
                "label": "Cerita",
                "type": "textarea",
                "rows": 4
              }
            ],
            "addLabel": "+ tambah babak"
          }
        ]
      },
      {
        "key": "galeri",
        "label": "Galeri",
        "icon": "image",
        "photos": [
          {
            "slot": "gallery",
            "label": "Foto galeri",
            "cardDesc": "Tiap foto dibingkai lengkung; potret (3:4) paling pas.",
            "ratio": "1/1",
            "max": 24
          }
        ]
      },
      {
        "key": "hadiah",
        "label": "Hadiah & Ucapan",
        "icon": "gift",
        "fields": [
          {
            "path": "gift.accounts",
            "type": "list",
            "label": "Rekening",
            "card": "Rekening",
            "item": [
              {
                "key": "bank",
                "label": "Bank",
                "type": "text"
              },
              {
                "key": "number",
                "label": "Nomor rekening",
                "type": "text"
              },
              {
                "key": "holder",
                "label": "Atas nama",
                "type": "text"
              },
              {
                "key": "owner",
                "label": "Pemilik rekening",
                "type": "select",
                "options": [
                  {
                    "value": "",
                    "label": "Tidak ikut"
                  },
                  {
                    "value": "cpw",
                    "label": "CPW (wanita)"
                  },
                  {
                    "value": "cpp",
                    "label": "CPP (pria)"
                  }
                ]
              },
              {
                "key": "placeholder",
                "label": "Sembunyikan nomor (placeholder)",
                "type": "switch"
              },
              {
                "key": "template",
                "label": "Pesan WA kustom",
                "type": "textarea",
                "rows": 3,
                "placeholder": "Pesan WA kustom (kosongkan = default). Token: ${tamu} ${CPP} ${CPW} ${LABEL}"
              }
            ],
            "addLabel": "+ tambah rekening"
          },
          {
            "path": "gift.contactCPW",
            "type": "text",
            "label": "CPW - nomor WA (62...)",
            "card": "Kontak WhatsApp konfirmasi",
            "cardDesc": "Dituju tombol Konfirmasi Pengiriman, dipilih otomatis dari field pemilik tiap rekening."
          },
          {
            "path": "gift.contactCPP",
            "type": "text",
            "label": "CPP - nomor WA (62...)",
            "card": "Kontak WhatsApp konfirmasi"
          },
          {
            "path": "gift.address.recipient",
            "type": "text",
            "label": "Penerima",
            "card": "Alamat kado"
          },
          {
            "path": "gift.address.phone",
            "type": "text",
            "label": "Telepon",
            "card": "Alamat kado"
          },
          {
            "path": "gift.address.detail",
            "type": "text",
            "label": "Detail alamat",
            "card": "Alamat kado"
          },
          {
            "path": "gift.address.template",
            "type": "textarea",
            "label": "Template pesan konfirmasi kado",
            "card": "Alamat kado",
            "rows": 3,
            "placeholder": "Token: ${tamu} ${CPP} ${CPW} ${LABEL}. Kosongkan = pesan default."
          }
        ],
        "photos": [
          {
            "slot": "gift_item",
            "label": "Rekomendasi kado",
            "cardDesc": "Nama, harga, dan link tiap rekomendasi diedit langsung pada kartu fotonya di bawah.",
            "ratio": "1/1",
            "max": 12
          }
        ]
      },
      {
        "key": "penutup",
        "label": "Penutup",
        "icon": "flag",
        "fields": [
          {
            "path": "closing.text",
            "type": "textarea",
            "label": "Teks penutup",
            "card": "Closing statement default",
            "cardDesc": "Dipakai untuk tamu yang tidak cocok dengan kelompok sapaan mana pun. Token: ${tamu} ${CPP} ${CPW}.",
            "rows": 4
          }
        ],
        "photos": [
          {
            "slot": "closing",
            "label": "Foto penutup",
            "ratio": "9/16",
            "max": 1,
            "cardDesc": "Foto latar penutup. Kosongkan untuk memakai ulang foto sampul."
          }
        ]
      }
    ]
  }
}
