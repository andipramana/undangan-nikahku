            "slot": "cover",
            "label": "Foto cover",
            "cardDesc": "Satu foto layar penuh di balik nama, bergerak lambat mengikuti gulir (parallax).",
            "ratio": "9/16",
            "min": 1,
            "max": 5
          }
        ]
      },
