{
  "id": "senja",
  "name": "Senja Golden Hour",
  "version": 1,
  "description": "Sinematik matahari terbenam dengan parallax 3 lapis, siluet perbukitan hangat, dan mask-wipe judul terikat scroll.",
  "assets": {
    "fonts": [
      "assets/fonts/fraunces/fraunces-latin.woff2",
      "assets/fonts/inter/inter-latin.woff2"
    ],
    "css": [],
    "js": [
      "assets/js/motion/scroll-scene.js",
      "assets/js/motion/split-text.js",
      "assets/js/motion/reveal.js",
      "assets/js/motion/tilt.js",
      "assets/js/motion/counter.js",
      "assets/js/countdown.js",
      "assets/js/audio-player.js",
      "assets/js/gift.js",
      "assets/js/rsvp.js",
      "assets/js/livestream.js",
      "assets/js/nav-menu.js",
      "assets/js/qr-checkin.js",
      "assets/js/theme.js",
      "assets/js/visual-editor/registry.js",
      "assets/js/visual-editor/guest-overrides.js"
    ]
  },
  "theme": {
    "--color-bg": "#1a1210",
    "--color-dark": "#120c0a",
    "--color-dark-2": "#241815",
    "--color-gold": "#f4a259",
    "--color-gold-soft": "#e76f51",
